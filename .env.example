BEST_GIFT_DB=best_gift_search.db
BEST_GIFT_CORS=http://localhost:5173
BEST_GIFT_RATE_LIMIT=120
# Optional shared key required as X-API-Key for /api/* routes.
# BEST_GIFT_API_KEY=
# auto uses OpenAI when OPENAI_API_KEY is present, otherwise deterministic demo mode.
BEST_GIFT_MODEL_PROVIDER=auto
BEST_GIFT_OPENAI_MODEL=gpt-5.6-luna
# OPENAI_API_KEY=
# Optional commerce endpoint returning a JSON array of Product objects.
# BEST_GIFT_CATALOG_URL=https://catalog.example.com/search
# BEST_GIFT_CATALOG_TOKEN=
# Preferred live product source. Keep this secret on the backend; never use it as a Vite variable.
# SERPAPI_API_KEY=
# Claude-powered fuzzy intent analysis and multi-query expansion.
# ANTHROPIC_API_KEY=
# BEST_GIFT_MODEL_PROVIDER=anthropic
# BEST_GIFT_ANTHROPIC_MODEL=claude-sonnet-4-20250514
